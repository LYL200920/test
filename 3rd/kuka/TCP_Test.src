GLOBAL DEF TCP_INIT(Timeout:IN)
   INT Timeout
   
   CONNECT_TIMEOUT = Timeout
   
   TXT_LOG_ON = FALSE
   SOCKET_XML[] = "Jutze_HIK"
   RECV_TAG[] = "MsgRecv"
   SEND_TAG[] = "MsgSend"
   
   $FLAG[CONNECT_FLAG] = FALSE
   $FLAG[MSG_FLAG] = FALSE
   
   EKI_RTN = EKI_Init(SOCKET_XML[])
END

GLOBAL DEFFCT INT TCP_CONNECT(Timeout:IN, Split:IN)
   INT Timeout
   CHAR Split
   INT COUNT
   REAL TICK 
   
   ;IF Timeout<10 THEN
      ;RETURN PARAM_ERROR
   ;ENDIF
   
   MSG_SPLIT = Split
   
   ;TCP_INIT(Timeout)
   ;EKI_RTN = EKI_Init(SOCKET_XML[])
   EKI_RTN = EKI_Open(SOCKET_XML[])
   IF (EKI_RTN.Msg_No <> 0) THEN
      RETURN CONNECT_ERROR
   ENDIF
   
   COUNT = 0
   TICK  = 0.05
   WHILE ($FLAG[CONNECT_FLAG] == FALSE) AND (COUNT <= Timeout / TICK)
      COUNT = COUNT + 1
      WAIT SEC TICK
   ENDWHILE

   IF $FLAG[CONNECT_FLAG] == TRUE THEN
      RETURN OK
   ELSE
      RETURN CONNECT_ERROR
   ENDIF
ENDFCT

GLOBAL DEFFCT INT TCP_CLOSE()
   EKI_RTN = EKI_Close(SOCKET_XML[])
   EKI_RTN = EKI_Clear(SOCKET_XML[])
   EKI_RTN = EKI_Init(SOCKET_XML[])
   WAIT SEC 1.0
   IF EKI_RTN.Msg_No == 0 THEN
      RETURN OK
   ELSE
      RETURN CONNECT_ERROR
   ENDIF
ENDFCT

DEFFCT BOOL IS_TCP_ALIVE()
   RETURN $FLAG[CONNECT_FLAG] == TRUE
   ;INT COUNT  
   ;REAL TICK
   ;
   ;COUNT = 0
   ;TICK = 0.05
   ;TRY_AGAIN_ALIVE:
   ;IF $FLAG[CONNECT_FLAG] == FALSE THEN
      ;COUNT = COUNT + 1
      ;WAIT SEC TICK
      ;IF COUNT > CONNECT_TIMEOUT / TICK THEN
         ;RETURN FALSE
      ;ENDIF
      ;GOTO TRY_AGAIN_ALIVE
   ;ENDIF
   ;RETURN TRUE
ENDFCT

DEFFCT BOOL IS_TCP_RECV(Timeout:IN)
   INT Timeout
   
   INT COUNT
   REAL TICK
   
   COUNT = 0
   TICK = 0.05
   
   TRY_AGAIN_RECV:
   IF $FLAG[MSG_FLAG] == FALSE THEN
      COUNT = COUNT + 1
      WAIT SEC TICK
      IF COUNT > Timeout / TICK THEN
         RETURN FALSE
      ENDIF
      GOTO TRY_AGAIN_RECV
   ENDIF
   $FLAG[MSG_FLAG] = FALSE
   RETURN TRUE
ENDFCT

GLOBAL DEFFCT INT TCP_SEND_STR(DATA[]:IN)
   DECL CHAR DATA[]
   
   IF (STRLEN(DATA[]) == 0) THEN
      RETURN PARAM_ERROR
   ENDIF
   
   IF (IS_TCP_ALIVE() <> TRUE) THEN
      RETURN NOT_CONNECTED
   ENDIF
   
   EKI_RTN = EKI_Send(SOCKET_XML[], DATA[])
   
   IF (EKI_RTN.Msg_No <> 0) THEN
      RETURN SEND_ERROR
   ENDIF
   RETURN OK
ENDFCT

GLOBAL DEFFCT INT TCP_SEND_POSE(Head[]:IN, Pose:IN)
   DECL CHAR Head[]
   DECL E6POS Pose
   
   DECL CHAR StrMsg[256]
   
   IF (STRLEN(Head[]) == 0) THEN
      RETURN PARAM_ERROR
   ENDIF
   
   IF (IS_TCP_ALIVE() <> TRUE) THEN
      RETURN NOT_CONNECTED
   ENDIF
   
   StrMsg[] = "\0"
   nOffset = 0
   SWRITE(StrMsg[],FSTATE,nOffset,"%s%c%f%c%f%c%f%c",Head[],MSG_SPLIT,Pose.X,MSG_SPLIT,Pose.Y,MSG_SPLIT,Pose.Z,MSG_SPLIT)
   IF(FSTATE.RET1 <> #CMD_OK) THEN
      RETURN PACK_ERROR
   ENDIF
   SWRITE(StrMsg[],FSTATE,nOffset,"%f%c%f%c%f",Pose.A,MSG_SPLIT,Pose.B,MSG_SPLIT,Pose.C)
   IF(FSTATE.RET1 <> #CMD_OK) THEN
      RETURN PACK_ERROR
   ENDIF
   
   EKI_RTN = EKI_Send(SOCKET_XML[], StrMsg[])
   
   IF (EKI_RTN.Msg_No <> 0) THEN
      RETURN SEND_ERROR
   ENDIF
   RETURN OK
ENDFCT

GLOBAL DEFFCT INT TCP_SEND_AXIS(Head[]:IN, Joint:IN)
   DECL CHAR Head[]
   DECL E6AXIS Joint
   
   DECL CHAR StrMsg[256]
   
   IF (STRLEN(Head[]) == 0) THEN
      RETURN PARAM_ERROR
   ENDIF
   
   IF (IS_TCP_ALIVE() <> TRUE) THEN
      RETURN NOT_CONNECTED
   ENDIF
   
   StrMsg[] = "\0"
   nOffset = 0
   SWRITE(StrMsg[],FSTATE,nOffset,"%s%c%f%c%f%c%f%c",Head[],MSG_SPLIT,Joint.A1,MSG_SPLIT,Joint.A2,MSG_SPLIT,Joint.A3,MSG_SPLIT)
   IF(FSTATE.RET1 <> #CMD_OK) THEN
      RETURN PACK_ERROR
   ENDIF
   SWRITE(StrMsg[],FSTATE,nOffset,"%f%c%f%c%f",Joint.A4,MSG_SPLIT,Joint.A5,MSG_SPLIT,Joint.A6)
   IF(FSTATE.RET1 <> #CMD_OK) THEN
      RETURN PACK_ERROR
   ENDIF
   
   EKI_RTN = EKI_Send(SOCKET_XML[], StrMsg[])
   
   IF (EKI_RTN.Msg_No <> 0) THEN
      RETURN SEND_ERROR
   ENDIF
   RETURN OK
ENDFCT

DEFFCT INT MIN(Value1:IN, Value2:IN)
   INT Value1, Value2
   
   IF (Value1 > Value2) THEN
      RETURN Value2
   ENDIF
   RETURN Value1
ENDFCT

GLOBAL DEFFCT INT TCP_RECV_STATE(Head[]:IN, Data:OUT, Timeout:IN)
   DECL CHAR Head[]
   INT Data
   INT Timeout
   
   INT RET, HeadLen, nStrPos
   DECL CHAR StrSeg[64]
   DECL CHAR RecvData[256]
   
   IF (IS_TCP_RECV(Timeout) <> TRUE) THEN
      RETURN RECV_ERROR
   ENDIF
   
   RecvData[] = "\0"
   EKI_RTN = EKI_GetString(SOCKET_XML[], RECV_TAG[], RecvData[])
   EKI_CHECK(EKI_RTN, #NOTIFY, SOCKET_XML[])
   
   HeadLen = STRLEN(Head[])
   IF (HeadLen <> 0) THEN
      StrSeg[] = "\0"
      STRCOPY_SEGMENT(1, HeadLen+1, RecvData[], StrSeg[])
      IF ((NOT STRCOMP(Head[], StrSeg[], #CASE_SENS)) OR (RecvData[HeadLen+1] <> MSG_SPLIT)) THEN
         RETURN UNPACK_ERROR
      ENDIF
      StrSeg[] = "/0"
      STRCOPY_SEGMENT(HeadLen+2, STRLEN(RecvData[])+1, RecvData[], StrSeg[])
   ELSE
      StrSeg[] = "/0"
      STRCOPY_SEGMENT(1, STRLEN(RecvData[])+1, RecvData[], StrSeg[])
   ENDIF
   
   nStrPos = STRFIND(1, StrSeg[], MSG_SPLIT, #CASE_SENS)
   IF (NOT STRTOINT(StrSeg[], Data)) THEN
      RETURN UNPACK_ERROR
   ENDIF
   RETURN OK
ENDFCT

GLOBAL DEFFCT INT TCP_RECV_INT(Head[]:IN, Data[]:OUT, Len:OUT, Timeout:IN)
   DECL CHAR Head[]
   DECL INT Data[]
   INT Len
   INT Timeout
   
   INT RP_RET, HeadLen
   DECL CHAR StrSeg[2047]
   DECL CHAR RecvData[2047]
   
   Len=0
   IF (IS_TCP_RECV(Timeout) <> TRUE) THEN
      RETURN RECV_ERROR
   ENDIF
   
   RecvData[] = "\0"
   EKI_RTN=EKI_GetString(SOCKET_XML[], RECV_TAG[], RecvData[])
   EKI_CHECK(EKI_RTN, #NOTIFY, SOCKET_XML[])
   
   HeadLen = STRLEN(Head[])
   IF (HeadLen<>0) THEN
      StrSeg[] = "\0"
      STRCOPY_SEGMENT(1, HeadLen+1,RecvData[],StrSeg[])
      IF((NOT STRCOMP(Head[], StrSeg[], #CASE_SENS)) OR (RecvData[HeadLen+1] <> MSG_SPLIT)) THEN
         RETURN UNPACK_ERROR
      ENDIF
      StrSeg[] = "\0"
      STRCOPY_SEGMENT(HeadLen+2, STRLEN(RecvData[])+1, RecvData[], StrSeg[])
   ELSE
      StrSeg[] = "\0"
      STRCOPY_SEGMENT(1, STRLEN(RecvData[])+1, RecvData[], StrSeg[])
   ENDIF
   
   RP_RET = MSGSPLIT_INT(StrSeg[], Data[], Len)
   RETURN RP_RET
ENDFCT

GLOBAL DEFFCT INT TCP_RECV_REAL(Head[]:IN, Data[]:OUT, Len:OUT, Timeout:IN)
   DECL CHAR Head[]
   DECL REAL Data[]
   INT Len
   INT Timeout
   
   INT RP_RET, HeadLen
   DECL REAL DataTemp[200]
   INT LenTemp, idx
   DECL CHAR StrSeg[2047]
   DECL CHAR RecvData[2047]
   
   Len=0
   IF (IS_TCP_RECV(Timeout) <> TRUE) THEN
      RETURN RECV_ERROR
   ENDIF
   
   RecvData[] = "\0"
   EKI_RTN=EKI_GetString(SOCKET_XML[], RECV_TAG[], RecvData[])
   EKI_CHECK(EKI_RTN, #NOTIFY, SOCKET_XML[])
   
   ;Head Check
   HeadLen = STRLEN(Head[])
   IF (HeadLen<>0) THEN
      StrSeg[] = "\0"
      STRCOPY_SEGMENT(1, HeadLen+1,RecvData[],StrSeg[])
      IF((NOT STRCOMP(Head[], StrSeg[], #CASE_SENS)) OR (RecvData[HeadLen+1] <> MSG_SPLIT)) THEN
         RETURN UNPACK_ERROR
      ENDIF
      StrSeg[] = "\0"
      STRCOPY_SEGMENT(HeadLen+2, STRLEN(RecvData[])+1, RecvData[], StrSeg[])
   ELSE
      StrSeg[] = "\0"
      STRCOPY_SEGMENT(1, STRLEN(RecvData[])+1, RecvData[], StrSeg[])
   ENDIF
   LenTemp = 0
   RP_RET = MSGSPLIT_REAL(StrSeg[], DataTemp[], LenTemp)
   IF(RP_RET<>0)THEN
      RETURN RP_RET
   ENDIF
   LEN = MIN(LenTemp, 200)
   FOR idx=1 TO LEN
      DATA[idx] = DataTemp[idx]
   ENDFOR
   RETURN RP_RET
ENDFCT

DEFFCT INT TCP_RECV_HELPER(Head[]:IN, Len:OUT, StrLeft[]:OUT, Timeout:IN)
   DECL CHAR Head[]
   DECL CHAR StrLeft[]
   INT Len
   INT Timeout
   
   INT Real_Len, idx, nStrPos
   INT RET, HeadLen
   DECL CHAR StrSeg[2047]
   DECL CHAR SizeData[10]
   
   Len=0
   IF (IS_TCP_RECV(Timeout) <> TRUE) THEN
      RETURN RECV_ERROR
   ENDIF
   
   StrLeft[] = "\0"
   EKI_RTN=EKI_GetString(SOCKET_XML[], RECV_TAG[], StrLeft[])
   EKI_CHECK(EKI_RTN, #NOTIFY, SOCKET_XML[])    
   
   ;Head Check
   HeadLen = STRLEN(Head[])
   IF (HeadLen<>0) THEN
      StrSeg[] = "\0"
      STRCOPY_SEGMENT(1, HeadLen+1,StrLeft[],StrSeg[])
      IF((NOT STRCOMP(Head[], StrSeg[], #CASE_SENS)) OR (StrLeft[HeadLen+1] <> MSG_SPLIT)) THEN
         Len = 0
         RETURN UNPACK_ERROR
      ENDIF
      StrSeg[] = "\0"
      STRCOPY_SEGMENT(HeadLen+2, STRLEN(StrLeft[])+1, StrLeft[], StrSeg[])
   ELSE
      StrSeg[] = "\0"
      STRCOPY_SEGMENT(1, STRLEN(StrLeft[])+1, StrLeft[], StrSeg[])
   ENDIF
   ;Size Check
   nStrPos = STRFIND(1, StrSeg[], MSG_SPLIT, #CASE_SENS)
   
   IF(nStrPos<=1) THEN
      StrLeft[] = "\0"
      SizeData[] = StrSeg[]
      IF(NOT STRTOINT(SizeData[], Len)) THEN
         Len = 0
         RETURN UNPACK_ERROR
      ENDIF
      IF(Len <= 0) THEN
         RETURN OK
      ENDIF
      RETURN UNPACK_ERROR
   ENDIF
   
   SizeData[] = "\0"
   STRCOPY_SEGMENT(1, nStrPos, StrSeg[], SizeData[])
   IF(NOT STRTOINT(SizeData[], Len)) THEN
      StrLeft[] = "\0"
      Len = 0
      STRCOPY_SEGMENT(nStrPos+1, STRLEN(StrSeg[])+1, StrSeg[], StrLeft[])
      RETURN UNPACK_ERROR
   ENDIF
   IF(Len < 1) THEN
      StrLeft[] = "\0"
      Len = 0
      STRCOPY_SEGMENT(nStrPos+1, STRLEN(StrSeg[])+1, StrSeg[], StrLeft[])
      RETURN OK
   ENDIF
   
   StrLeft[] = "\0"
   STRCOPY_SEGMENT(nStrPos+1, STRLEN(StrSeg[])+1, StrSeg[], StrLeft[])
   RETURN OK
ENDFCT

GLOBAL DEFFCT INT TCP_RECV_POSE(Head[]:IN, Data[]:OUT, Len:OUT, Timeout:IN)
   DECL CHAR Head[]
   DECL E6POS Data[]
   INT Len
   INT Timeout
   
   DECL REAL Real_Data[200]
   INT Real_Len, idx, nStrPos
   INT RET
   DECL CHAR RecvData[2047]
   
   RET = TCP_RECV_HELPER(Head[], Len, RecvData[], Timeout)
   IF((RET <> OK) OR (Len == 0)) THEN
      RETURN RET
   ENDIF
   
   ;兄 ?n?    Real_Len = Len*6
   RET = MSGSPLIT_REAL(RecvData[], Real_Data[], Real_Len)
   IF(RET <> OK) THEN
      RETURN RET
   ENDIF
   
   FOR idx = 1 to LEN
      Data[idx].X = Real_Data[idx*6-5]
      Data[idx].Y = Real_Data[idx*6-4]
      Data[idx].Z = Real_Data[idx*6-3]
      Data[idx].A = Real_Data[idx*6-2]
      Data[idx].B = Real_Data[idx*6-1]
      Data[idx].C = Real_Data[idx*6]
   ENDFOR
   
   RETURN OK
ENDFCT

GLOBAL DEFFCT INT TCP_RECV_POSE_RLAB(Head[]:IN, Data[]:OUT, Len:OUT, rValue[]:OUT, rNum:OUT, Timeout:IN)
   DECL CHAR Head[]
   DECL E6POS Data[]
   INT Len
   DECL REAL rValue[]
   INT rNum
   INT Timeout
   
   DECL REAL Real_Data[200]
   INT Real_Len, idx, nStrPos
   INT RET
   DECL CHAR RecvData[2047]
   
   RET = TCP_RECV_HELPER(Head[], Len, RecvData[], Timeout)
   IF(RET <> OK) THEN
      RETURN RET
   ENDIF
   
   IF(Len <> 0) THEN
      ;兄 ?n筡:POSEpn
      Real_Len = Len*6
      RET = MSGSPLIT_REAL(RecvData[], Real_Data[], Real_Len)
      IF(RET <> OK) THEN
         RETURN RET
      ENDIF
      
      FOR idx = 1 to LEN
         Data[idx].X = Real_Data[idx*6-5]
         Data[idx].Y = Real_Data[idx*6-4]
         Data[idx].Z = Real_Data[idx*6-3]
         Data[idx].A = Real_Data[idx*6-2]
         Data[idx].B = Real_Data[idx*6-1]
         Data[idx].C = Real_Data[idx*6]
      ENDFOR
   ENDIF
   ;兄i
n筽
   rNum = 0
   RET = MSGSPLIT_REAL(RecvData[], rValue[], rNum)
   RETURN RET
ENDFCT

