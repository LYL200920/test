GLOBAL DEFFCT INT TCP_RECV_AXIS(Head[]:IN, Data[]:OUT, Len:OUT, Timeout:IN)
   DECL CHAR Head[]
   DECL E6AXIS Data[]
   INT Len
   INT Timeout
   
   DECL REAL Real_Data[200]
   INT Real_Len, idx, nStrPos
   INT RET
   DECL CHAR RecvData[2047]
   
   RET = TCP_RECV_HELPER(Head[], Len, RecvData[], Timeout)
   IF((RET <> OK) OR (Len == 0)) THEN
      RETURN RET
   ENDIF
   
   ;兄 ?n?    Real_Len = Len*6
   RET = MSGSPLIT_REAL(RecvData[], Real_Data[], Real_Len)
   IF(RET <> OK) THEN
      RETURN RET
   ENDIF
   
   FOR idx = 1 to LEN
      Data[idx].A1 = Real_Data[idx*6-5]
      Data[idx].A2 = Real_Data[idx*6-4]
      Data[idx].A3 = Real_Data[idx*6-3]
      Data[idx].A4 = Real_Data[idx*6-2]
      Data[idx].A5 = Real_Data[idx*6-1]
      Data[idx].A6 = Real_Data[idx*6]
   ENDFOR
   
   RETURN OK
ENDFCT

GLOBAL DEFFCT INT TCP_RECV_STR(Head[]:IN, DATA[]:OUT, Timeout:IN)
   DECL CHAR Head[]
   DECL CHAR DATA[]
   INT Timeout
   
   DECL CHAR StrSeg[64]
   DECL CHAR RecvData[2047]
   INT nIdx,HeadLen
   
   IF (IS_TCP_RECV(Timeout) <> TRUE) THEN
      RETURN RECV_ERROR
   ENDIF
   
   RecvData[] = "\0"
   EKI_RTN=EKI_GetString(SOCKET_XML[], RECV_TAG[], RecvData[])
   EKI_CHECK(EKI_RTN, #NOTIFY, SOCKET_XML[])
   
   ;Head Check
   HeadLen = STRLEN(Head[])
   IF (HeadLen<>0) THEN
      StrSeg[] = "\0"
      STRCOPY_SEGMENT(1, HeadLen+1,RecvData[],StrSeg[])
      IF((NOT STRCOMP(Head[], StrSeg[], #CASE_SENS)) OR (RecvData[HeadLen+1] <> MSG_SPLIT)) THEN
         RETURN UNPACK_ERROR
      ENDIF
      DATA[] = "\0"
      STRCOPY_SEGMENT(HeadLen+2, STRLEN(RecvData[])+1, RecvData[], DATA[])
   ELSE
      DATA[] = "\0"
      STRCOPY_SEGMENT(1, STRLEN(RecvData[])+1, RecvData[], DATA[])
   ENDIF
   
   RETURN OK
ENDFCT

DEFFCT INT MSGSPLIT_INT(StrMsg[]:IN, ArrInt[]:OUT, ArrayLen:OUT)
   DECL CHAR StrMsg[]
   DECL INT ArrInt[]
   INT ArrayLen
   
   DECL CHAR StrSeg[64]
   INT nIdx, nStart, nEnd, nLen, nVal, nStrPos
   
   StrSeg[] = "\0"
   nStrPos = 1
   
   nLen = STRLEN(StrMsg[])
   IF nStrPos >= nLen THEN
      RETURN UNPACK_ERROR
   ENDIF
   
   ArrayLen = 0
   nStart = nStrPos
   REPEAT
      IF (ArrayLen >= 200) THEN
         RETURN OK
      ENDIF
      nStrPos = STRFIND(nStart, StrMsg[], MSG_SPLIT, #CASE_SENS)
      IF nStrPos==0 THEN
         nEnd = nLen + 1
      ELSE
         nEnd = nStart + nStrPos - 1
      ENDIF
      STRCOPY_SEGMENT(nStart, nEnd, StrMsg[], StrSeg[])
      IF STRTOINT(StrSeg[], nVal) THEN  
         ArrayLen = ArrayLen + 1
         ArrInt[ArrayLen] = nVal
      ELSE
         IF(ArrayLen>0) THEN
            RETURN OK
         ELSE
            RETURN UNPACK_ERROR
         ENDIF
      ENDIF
      StrSeg[] = "\0"
      nStart = nEnd + 1
   UNTIL nEnd >= nLen
   RETURN OK
ENDFCT

DEFFCT INT MSGSPLIT_REAL(StrMsg[]:OUT, ArrReal[]:OUT, ArrayLen:OUT)
   DECL CHAR StrMsg[]
   DECL REAL ArrReal[]
   INT ArrayLen
   
   DECL CHAR StrMsgLeft[2047]
   DECL CHAR StrSeg[64]
   INT nIdx, nStart, nEnd, nLen, nStrPos, rNum
   REAL nVal
   
   nStrPos = 1
   StrSeg[] = "\0"
   
   nLen = STRLEN(StrMsg[])
   IF nStrPos >= nLen THEN
      RETURN UNPACK_ERROR
   ENDIF
   
   rNum = 0
   nStart = nStrPos
   REPEAT
      IF ((rNum == 200) OR ((ArrayLen <> 0) AND (rNum == ArrayLen))) THEN
         StrMsgLeft[] = "\0"
         STRCOPY_SEGMENT(nStart, nLen + 1, StrMsg[], StrMsgLeft[])
         StrMsg[] = StrMsgLeft[]
         ArrayLen = rNum
         RETURN OK
      ENDIF
      
      nStrPos = STRFIND(nStart, StrMsg[], MSG_SPLIT, #CASE_SENS)
      IF nStrPos==0 THEN
         nEnd = nLen + 1
      ELSE
         nEnd = nStart + nStrPos - 1
      ENDIF
      STRCOPY_SEGMENT(nStart, nEnd, StrMsg[], StrSeg[])
      IF STRTOREAL(StrSeg[], nVal) THEN  
         rNum = rNum + 1
         ArrReal[rNum] = nVal
      ELSE
         IF((rNum>0) AND (ArrayLen == 0)) THEN
            ArrayLen = rNum
            RETURN OK
         ELSE
            RETURN UNPACK_ERROR
         ENDIF
      ENDIF
      StrSeg[] = "\0"
      nStart = nEnd + 1
   UNTIL nEnd >= nLen
   
   IF((ArrayLen <> 0) AND (rNum <> ArrayLen)) THEN
      RETURN UNPACK_ERROR
   ENDIF
   ArrayLen = rNum
   RETURN OK
ENDFCT

DEF STRCOPY_SEGMENT(nStart:IN, nEnd:IN, StrRaw[]:IN, StrCut[]:OUT)
   INT nStart, nEnd
   DECL CHAR StrRaw[]
   DECL CHAR StrCut[]
   
   INT nIdx
   FOR nIdx = 1 TO MIN(nEnd-nStart,STRDECLLEN(StrCut[])) STEP 1
      StrCut[nIdx] = StrRaw[nIdx+nStart-1]
   ENDFOR
   StrCut[nIdx] = 0 
END

